                        <label class="block text-xs font-semibold text-gray-300 mb-1">Your Full Name / Gamer Tag</label>
                        <input type="text" id="userName" required placeholder="e.g. ShadowAssassin99" class="w-full bg-gray-900 border border-gray-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-gold-500 transition">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-300 mb-1">Your Message / Prize Claim Details</label>
                        <textarea id="userMessage" required rows="3" placeholder="Enter your player ID or claim notes here..." class="w-full bg-gray-900 border border-gray-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-gold-500 transition resize-none"></textarea>
                    </div>

                    <div id="formStatus" class="hidden text-xs p-3 rounded-xl"></div>

                    <button type="submit" id="submitFormBtn" class="w-full py-3.5 bg-gradient-to-r from-gold-600 via-gold-500 to-amber-400 text-gamingDark font-black text-sm rounded-xl tracking-wider shadow-lg hover:brightness-110 active:scale-[0.98] transition">
                        SEND MESSAGE 🚀
                    </button>
                </form>

            </div>
        </div>

        <!-- Loss Result Modal -->
        <div id="lossModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
            <div class="bg-gamingCard border border-neonRed/50 rounded-2xl w-full max-w-sm p-6 text-center glow-red shadow-2xl animate-in fade-in zoom-in duration-200">
                <div class="w-16 h-16 bg-red-500/10 border border-neonRed/30 rounded-2xl mx-auto flex items-center justify-center text-3xl mb-3 text-neonRed">
                    ❌
                </div>
                <h3 class="text-xl font-black text-white">YOU LOSS</h3>
                <p class="text-xs text-gray-400 mt-2 mb-6">Better luck next time! The wheel has spoken. Each browser gets only 1 spin.</p>
                <button onclick="closeLossModal()" class="w-full py-3 bg-gray-800 hover:bg-gray-700 text-white font-bold text-sm rounded-xl transition">
                    Got it
