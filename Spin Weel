        <!-- Spin Wheel Container -->
        <div id="wheelContainerSection" class="w-full max-w-md flex flex-col items-center justify-center opacity-60 pointer-events-none transition-all duration-300">
            
            <div class="relative w-72 h-72 sm:w-80 sm:h-80 mb-6">
