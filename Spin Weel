            <!-- Large SPIN Button -->
            <button id="spinBtn" onclick="spinWheel()" disabled class="w-full py-4 rounded-2xl bg-gradient-to-r from-gold-600 via-gold-500 to-amber-400 text-gamingDark font-black text-lg tracking-wider shadow-xl opacity-50 cursor-not-allowed hover:brightness-110 active:scale-[0.98] transition-all glow-gold">
                SPIN NOW 🎰
            </button>
            
            <p class="text-[11px] text-gray-500 text-center mt-3">
                Note: Limited to 1 spin per browser session (stored locally). Server-side protection requires custom backend storage.
            </p>
        </div>

        <!-- Weekly Lite Success & Message Form Modal -->
        <div id="successModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
            <div class="bg-gamingCard border border-gold-500/50 rounded-2xl w-full max-w-md p-6 relative glow-gold shadow-2xl animate-in fade-in zoom-in duration-200">
                
                <!-- Close / Minimize -->
                <div class="text-center mb-5">
                    <div class="w-16 h-16 bg-gradient-to-tr from-gold-500 to-amber-300 rounded-2xl mx-auto flex items-center justify-center text-3xl mb-3 shadow-lg glow-gold">
                        🎉
                    </div>
                    <span class="text-xs uppercase font-extrabold tracking-widest text-gold-400 bg-gold-500/10 px-3 py-1 rounded-full border border-gold-500/20">JACKPOT WINNER!</span>
                    <h3 class="text-2xl font-black text-white mt-2">WEEKLY LITE UNLOCKED</h3>
                    <p class="text-xs text-gray-300 mt-1">Submit your details below to claim your reward instantly from the administration team.</p>
                </div>

                <!-- Formspree Form -->
                <form id="rewardForm" onsubmit="submitRewardForm(event)" class="space-y-4">
