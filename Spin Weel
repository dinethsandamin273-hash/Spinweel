                <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 z-30 w-0 h-0 border-l-[14px] border-l-transparent border-r-[14px] border-r-transparent border-t-[24px] border-t-gold-400 filter drop-shadow-[0_0_8px_rgba(245,158,11,0.8)]"></div>
                
                <!-- Outer Glowing Ring -->
                <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-neonRed via-gold-500 to-neonBlue p-1.5 glow-gold">
                    <div class="w-full h-full bg-gamingDark rounded-full relative overflow-hidden flex items-center justify-center">
                        
                        <!-- The Canvas Wheel -->
                        <canvas id="spinCanvas" width="320" height="320" class="w-full h-full rounded-full transition-transform duration-[4000ms] cubic-bezier(0.15, 0.85, 0.15, 1)"></canvas>
                        
                        <!-- Center Hub / Spin Button Overlay or Indicator -->
                        <div class="absolute w-14 h-14 rounded-full bg-gamingCard border-2 border-gold-400 shadow-2xl flex items-center justify-center text-gold-400 font-black text-xs z-20">
