    </main>

    <!-- Footer -->
    <footer class="w-full border-t border-gray-800/80 bg-gamingCard/40 py-4 text-center text-xs text-gray-500">
        <p>&copy; 2026 Elite Gaming Rewards. All rights reserved.</p>
    </footer>

    <script>
        // State management
        const totalSteps = 4;
        let confirmedSteps = [false, false, false, false];
        let visitedSteps = [false, false, false, false];
        let hasSpun = false;

        // Check localStorage on load
        window.addEventListener('DOMContentLoaded', () => {
            const savedSpin = localStorage.getItem('elite_wheel_spun');
            if (savedSpin === 'true') {
                hasSpun = true;
                lockEverythingAfterSpin();
            } else {
                // Load unlock states if any stored
                const savedConfirms = localStorage.getItem('elite_confirmed_steps');
                if (savedConfirms) {
                    try {
                        confirmedSteps = JSON.parse(savedConfirms);
                        for (let i = 0; i < totalSteps; i++) {
                            if (confirmedSteps[i]) {
                                markStepCompleted(i + 1);
                            }
                        }
                    } catch (e) {}
                }
                updateUnlockProgress();
            }
            initWheel();
        });

        // Handle Visit Ad URL
        function handleVisitAd(stepNum) {
            visitedSteps[stepNum - 1] = true;
            // Alternate between adUrl1 and adUrl2
            const targetUrl = (stepNum % 2 !== 0) ? CONFIG_ADS.adUrl1 : CONFIG_ADS.adUrl2;
            
            // Open ad in new tab
            window.open(targetUrl, '_blank');

            // Enable confirm button for this step
            const confirmBtn = document.getElementById(`confirmBtn${stepNum}`);
            confirmBtn.disabled = false;
            confirmBtn.classList.remove('bg-gray-800', 'text-gray-500', 'cursor-not-allowed');
            confirmBtn.classList.add('bg-green-600/20', 'text-green-400', 'border', 'border-green-500/30', 'hover:bg-green-600/30');
            
            const visitBtn = document.getElementById(`visitBtn${stepNum}`);
            visitBtn.textContent = 'Visited ✓';
        }

        // Handle Confirm Step
        function handleConfirmStep(stepNum) {
            if (!visitedSteps[stepNum - 1]) {
                return;
            }
            confirmedSteps[stepNum - 1] = true;
            localStorage.setItem('elite_confirmed_steps', JSON.stringify(confirmedSteps));
            markStepCompleted(stepNum);
            updateUnlockProgress();
        }

        function markStepCompleted(stepNum) {
            const row = document.getElementById(`stepRow${stepNum}`);
            row.classList.add('border-green-500/40', 'bg-green-950/10');

            const icon = document.getElementById(`stepIcon${stepNum}`);
            icon.className = "w-8 h-8 rounded-lg bg-green-500/20 text-green-400 border border-green-500/30 font-bold flex items-center justify-center text-xs";
            icon.textContent = "✓";

            const visitBtn = document.getElementById(`visitBtn${stepNum}`);
            visitBtn.disabled = true;
            visitBtn.classList.add('opacity-50', 'cursor-not-allowed');

            const confirmBtn = document.getElementById(`confirmBtn${stepNum}`);
            confirmBtn.textContent = "Confirmed";
            confirmBtn.disabled = true;
            confirmBtn.className = "px-3 py-1.5 bg-green-500/20 text-green-400 text-xs font-semibold rounded-lg cursor-default";
        }

        function updateUnlockProgress() {
            const completedCount = confirmedSteps.filter(Boolean).length;
            document.getElementById('unlockProgress').textContent = completedCount;

            if (completedCount === totalSteps) {
                // All steps completed! Unlock wheel
                const badge = document.getElementById('unlockStatusBadge');
                badge.textContent = "Unlocked";
                badge.className = "text-xs bg-green-500/10 text-green-400 border border-green-500/20 px-2.5 py-1 rounded-md font-medium";

                // Fade out unlock section slightly & activate wheel container
                const wheelContainer = document.getElementById('wheelContainerSection');
                wheelContainer.classList.remove('opacity-60', 'pointer-events-none');

                const spinBtn = document.getElementById('spinBtn');
                spinBtn.disabled = false;
                spinBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
        }

        const segments = [
            { text: "WEEKLY LITE", color: "#f59e0b", textColor: "#0a0b10" }, // Gold
            { text: "YOU LOSS", color: "#1f2937", textColor: "#ef4444" },    // Dark / Red
            { text: "YOU LOSS", color: "#111827", textColor: "#ef4444" },    // Darker / Red
            { text: "YOU LOSS", color: "#1f2937", textColor: "#ef4444" }     // Dark / Red
        ];

        let currentRotation = 0;
        let isSpinning = false;

        function initWheel() {
            const canvas = document.getElementById('spinCanvas');
            const ctx = canvas.getContext('2d');
            drawWheel(ctx, 0);
        }

        function drawWheel(ctx, angleOffset) {
            const width = ctx.canvas.width;
            const height = ctx.canvas.height;
            const centerX = width / 2;
            const centerY = height / 2;
            const radius = width / 2 - 4;

            ctx.clearRect(0, 0, width, height);

            const arcSize = (2 * Math.PI) / segments.length;

            segments.forEach((seg, i) => {
                const startAngle = angleOffset + i * arcSize;
                const endAngle = startAngle + arcSize;

                // Draw Slice
                ctx.beginPath();
                ctx.moveTo(centerX, centerY);
                ctx.arc(centerX, centerY, radius, startAngle, endAngle);
                ctx.closePath();
                ctx.fillStyle = seg.color;
                ctx.fill();

                ctx.lineWidth = 2;
                ctx.strokeStyle = '#374151';
                ctx.stroke();

                // Draw Text
                ctx.save();
                ctx.translate(centerX, centerY);
                ctx.rotate(startAngle + arcSize / 2);
                ctx.textAlign = "right";
                ctx.fillStyle = seg.textColor;
                ctx.font = "bold 13px Inter";
                ctx.fillText(seg.text, radius - 20, 5);
                ctx.restore();
            });
        }

        function spinWheel() {
            if (isSpinning || hasSpun) return;
            
            isSpinning = true;
            hasSpun = true;
            localStorage.setItem('elite_wheel_spun', 'true');

            const spinBtn = document.getElementById('spinBtn');
            spinBtn.disabled = true;
            spinBtn.classList.add('opacity-50', 'cursor-not-allowed');

            // Determine winning segment. Let index 0 ("WEEKLY LITE") or index 1,2,3 ("YOU LOSS").
            // For excitement, let's allow a randomized spin where WEEKLY LITE has a fair slice or predetermined win.
            // Let's target segment index 0 for testing or random 0-3. Let's make it random but bias slightly or pure random:
            const winningIndex = Math.floor(Math.random() * segments.length);
            
            const degreesPerSegment = 360 / segments.length;
            // Calculate exact angle to stop pointer at the top (pointer is at 270 degrees or -90 deg in canvas terms)
            // Center of segment i is i * degreesPerSegment + degreesPerSegment / 2
            const targetSegmentCenterAngle = winningIndex * degreesPerSegment + degreesPerSegment / 2;
            
            // Full rotations (e.g., 6 to 8 full spins = 2160 to 2880 degrees)
            const extraSpins = 360 * 6;
            const totalDegrees = extraSpins + (360 - targetSegmentCenterAngle);
            
            currentRotation += totalDegrees;

            const canvas = document.getElementById('spinCanvas');
            canvas.style.transform = `rotate(${currentRotation}deg)`;

            // Wait for CSS transition to finish (4 seconds)
            setTimeout(() => {
                isSpinning = false;
                if (winningIndex === 0) {
                    // WEEKLY LITE WON!
                    document.getElementById('successModal').classList.remove('hidden');
                } else {
                    // YOU LOSS
                    document.getElementById('lossModal').classList.remove('hidden');
                }
            }, 4100);
        }

        function closeLossModal() {
            document.getElementById('lossModal').classList.add('hidden');
        }

        async function submitRewardForm(e) {
            e.preventDefault();
            const name = document.getElementById('userName').value.trim();
            const message = document.getElementById('userMessage').value.trim();
            const statusDiv = document.getElementById('formStatus');
            const submitBtn = document.getElementById('submitFormBtn');

            if (!name || !message) {
                statusDiv.textContent = "Please fill in all fields.";
                statusDiv.className = "text-xs p-3 rounded-xl bg-red-500/10 text-neonRed border border-red-500/20 block";
                return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = "SENDING...";
            statusDiv.className = "hidden";

            try {
                const response = await fetch("https://formspree.io/f/mvkzrqnk", {
                    method: "POST",
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ name: name, message: message, prize: "WEEKLY LITE" })
                });

                if (response.ok) {
                    statusDiv.textContent = "Success! Your reward claim message has been sent to the admin.";
                    statusDiv.className = "text-xs p-3 rounded-xl bg-green-500/10 text-green-400 border border-green-500/30 block";
                    submitBtn.textContent = "SENT SUCCESSFULLY ✓";
                } else {
                    const data = await response.json();
                    throw new Error(data.error || 'Submission failed');
                }
            } catch (err) {
                statusDiv.textContent = "Error sending message. Please try again or check your connection.";
                statusDiv.className = "text-xs p-3 rounded-xl bg-red-500/10 text-neonRed border border-red-500/20 block";
                submitBtn.disabled = false;
                submitBtn.textContent = "SEND MESSAGE 🚀";
            }
        }

        function lockEverythingAfterSpin() {
            // If already spun previously, disable unlock and wheel
            const unlockSection = document.getElementById('unlockSection');
            unlockSection.style.opacity = '0.5';
            unlockSection.style.pointerEvents = 'none';

            const wheelContainer = document.getElementById('wheelContainerSection');
            wheelContainer.classList.remove('opacity-60', 'pointer-events-none');
            const spinBtn = document.getElementById('spinBtn');
            spinBtn.disabled = true;
